{
  "name": "agent-wiki-graph-mcp",
  "version": "1.0.0",
  "description": "Schema-enforcing MCP server for an agent-wiki-graph vault. Read broadly, write only to _agents/inbox/.",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/http.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/themsquared/agent-wiki-graph"
  },
  "keywords": [
    "mcp",
    "agent-wiki-graph",
    "wiki",
    "memory"
  ],
  "author": "Mike Moore",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
